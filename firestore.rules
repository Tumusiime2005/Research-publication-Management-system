rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Publications collection: public read & researcher/admin writes
    match /publications/{publicationId} {
      allow read, create, update, delete: if true;
    }

    // User accounts collection (synced between User App and Separate Admin Dashboard)
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }

    // System state & one-time reset markers
    match /system/{docId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
