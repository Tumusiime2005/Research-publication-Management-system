# ==============================================================================
# BRAIN HUB ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/brain_hub_db
SPRING_DATASOURCE_USERNAME=brain_user
SPRING_DATASOURCE_PASSWORD=brain_secure_pass_2026

# JWT Security
JWT_SECRET=4c7e9a8f2b1d6c0e5a8f7b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Administrator Bootstrap Token (Required for initializing the first admin account)
ADMIN_BOOTSTRAP_TOKEN=BH-BOOTSTRAP-SECURE-KEY-2026

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://brain-hub.vercel.app

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/publications

# Optional S3 / MinIO Configuration
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET_NAME=brain-hub-publications
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Server Port
PORT=8080
